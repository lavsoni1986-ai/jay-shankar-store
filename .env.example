# ============================================================
# Jay Shankar Readymade Store — Environment Variables Template
# Copy this file to .env or .env.local and fill in your actual credentials.
# NEVER commit .env or secret credentials to source control.
# ============================================================

# 1. DATABASE (PostgreSQL / Supabase / Neon / AWS RDS)
# ------------------------------------------------------------
# Transaction pooler URL or direct connection URL
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/YOUR_DB_NAME?sslmode=require"
# Direct URL for Prisma migrations (optional, useful for connection poolers like Supabase/Neon)
DIRECT_URL="postgresql://postgres:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/YOUR_DB_NAME?sslmode=require"

# 2. ADMIN AUTHENTICATION (Bcrypt + Jose JWT Session)
# ------------------------------------------------------------
# Secret key used to sign JWT cookies (minimum 32 random characters)
AUTH_SECRET="replace-with-a-very-long-random-secret-key-at-least-32-characters"

# Initial admin credentials for seeding (Required for first-time seed only)
ADMIN_EMAIL="admin@jayshankarstore.com"
ADMIN_INITIAL_PASSWORD="ReplaceWithAStrongAdminPassword123!"

# 3. CLOUDINARY MEDIA STORAGE
# ------------------------------------------------------------
# Found in your Cloudinary Dashboard (Settings > Access Keys)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# 4. PUBLIC SITE SETTINGS
# ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://jayshankarstore.com"
