// ============================================================
// Prisma Schema — Jay Shankar Readymade Store
// PostgreSQL Database Schema for B2B Wholesale Platform
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Admin")
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_users")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  nameHindi   String
  slug        String    @unique
  description String
  icon        String    @default("Package")
  isCore      Boolean   @default(false)
  color       String    @default("bg-blue-50")
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([isCore])
  @@index([slug])
  @@map("categories")
}

model Brand {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  description     String
  logoPlaceholder String
  logoUrl         String?
  accentColor     String    @default("#0F2A5C")
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  products        Product[]

  @@index([slug])
  @@map("brands")
}

model Product {
  id               String         @id @default(cuid())
  name             String
  slug             String         @unique
  description      String
  shortDescription String
  categoryId       String
  category         Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  brandId          String?
  brand            Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  tags             String[]       @default([])
  isWholesale      Boolean        @default(true)
  isFeatured       Boolean        @default(false)
  isPublished      Boolean        @default(true)
  enquiryAvailable Boolean        @default(true)
  isDemo           Boolean        @default(false)
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  images           ProductImage[]

  @@index([categoryId])
  @@index([brandId])
  @@index([slug])
  @@index([isPublished])
  @@index([isFeatured])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  publicId  String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}
